{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vozodrom",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The bundled worker is ~3.2 MiB gzip, above the Workers Free limit: needs Workers Paid.
  "workers_dev": true,
  // Custom domains: Cloudflare creates and owns their DNS records in the vozodrom.cz zone.
  "routes": [
    { "pattern": "vozodrom.cz", "custom_domain": true },
    { "pattern": "www.vozodrom.cz", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Postgres (Neon project vozodrom, Frankfurt) through Hyperdrive config vozodrom-db, query caching off
  // so session and ban changes apply at once. Locally `npm run db:local` serves PGlite on 5433.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "55126eac3b8e460fa44063226499de43",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/postgres"
    }
  ],
  // BETTER_AUTH_URL is public; secrets (BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET, …) come from
  // `wrangler secret put` in production and from .dev.vars locally.
  "vars": { "BETTER_AUTH_URL": "https://vozodrom.cz" }
}
