{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vozodrom",
  // worker/index.ts wraps the OpenNext app (.open-next/worker.js) and adds chat WebSockets and the cron.
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The bundled worker is ~3.2 MiB gzip, above the Workers Free limit: needs Workers Paid.
  "workers_dev": true,
  // Custom domains: Cloudflare creates and owns their DNS records in the vozodrom.cz zone.
  "routes": [
    { "pattern": "vozodrom.cz", "custom_domain": true },
    { "pattern": "www.vozodrom.cz", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Postgres (Neon project vozodrom, Frankfurt) through Hyperdrive config vozodrom-db, query caching off
  // so session and ban changes apply at once. Locally `npm run db:local` serves PGlite on 5433.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "55126eac3b8e460fa44063226499de43",
      "localConnectionString": "postgres://postgres:postgres@127.0.0.1:5433/postgres"
    }
  ],
  // Listing photos (resized in the browser), EU jurisdiction. Served by /foto/[...key].
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "vozodrom-photos", "jurisdiction": "eu" }],
  // BETTER_AUTH_URL is public; secrets (BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET, …) come from
  // `wrangler secret put` in production and from .dev.vars locally.
  // SIGNUP_OPEN: "false" closes registration (e.g. if e-mail sending breaks; see src/lib/mail.ts).
  // MAIL_FROM switches sending on; without it (locally) mail is only logged.
  "vars": { "BETTER_AUTH_URL": "https://vozodrom.cz", "SIGNUP_OPEN": "true", "MAIL_FROM": "Vozodrom <noreply@vozodrom.cz>" },
  // Cloudflare Email Service; vozodrom.cz is onboarded for sending (SPF/DKIM on cf-bounce, DMARC).
  "send_email": [{ "name": "EMAIL" }],
  // Chat: one Inbox per user holds its open WebSockets (worker/index.ts).
  "durable_objects": { "bindings": [{ "name": "INBOX", "class_name": "Inbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Inbox"] }],
  // Daily watchdog (hlídací pes) at 06:00 UTC.
  "triggers": { "crons": ["0 6 * * *"] }
}
